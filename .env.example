# Configuración del Agente de Seguros Horizonte S.A.
# Fecha de referencia fijada por negocio: 2026-10-15

# Proveedor de IA (openai, groq, ollama, azure, o mock para ejecución offline)
AI_PROVIDER=openai

# Clave de API (si usas OpenAI, Groq, etc.)
OPENAI_API_KEY=tu_api_key_aqui

# URL base opcional (para Ollama o proveedores compatibles con OpenAI)
# Para Ollama local: http://localhost:11434/v1
# Para Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Modelo a utilizar (ejemplo: gpt-4o-mini, gpt-4o, llama3.1, mistral)
AI_MODEL=gpt-4o-mini

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
